{
  "manifest_version": 3,
  "name": "JanMitra AI – Government Form Assistant",
  "description": "Offline Chrome extension that detects and helps fill a single supported government-style test form.",
  "version": "1.0",
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "JanMitra AI"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "file:///*",
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "config/formMapping.js",
        "content/fieldDetector.js",
        "content/formFiller.js",
        "content/content.js"
      ]
    }
  ]
}
